{
  "name": "file-navigator",
  "publisher": "posit",
  "displayName": "File Navigator",
  "description": "Directory browser sidebar for navigating the filesystem",
  "version": "0.1.0",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://github.com/posit-dev/file-navigator-extension",
  "bugs": {
    "url": "https://github.com/posit-dev/file-navigator-extension/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "file browser",
    "file explorer",
    "files",
    "directory",
    "folder",
    "positron"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "File Navigator",
      "properties": {
        "fileNavigator.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the File Navigator in the activity bar. When off, the view and its activity bar icon are hidden."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "file-navigator",
          "title": "File Navigator",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "file-navigator": [
        {
          "type": "webview",
          "id": "file-navigator.directoryView",
          "name": "File Navigator",
          "icon": "images/icon.svg",
          "when": "config.fileNavigator.enabled"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsx esbuild.ts --production",
    "watch": "tsx esbuild.ts --watch",
    "clean": "rm -rf dist",
    "compile-tests": "tsc -p tsconfig.test.json",
    "pretest": "npm run build && npm run compile-tests",
    "test": "vscode-test",
    "package": "npm run check-types && npm run lint && npm run clean && npm run build && vsce package --no-dependencies",
    "check-types": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint -c .oxlintrc.json src"
  },
  "devDependencies": {
    "@pierre/trees": "1.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/vscode": "^1.100.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.0",
    "esbuild-plugin-tailwindcss": "^2.1.0",
    "lucide-react": "^0.552.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.93.0",
    "preact": "11.0.0-beta.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/posit-dev/file-navigator-extension.git"
  }
}
